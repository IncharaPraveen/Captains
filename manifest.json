{
  "manifest_version": 3,
  "name": "Captains",
  "version": "0.1.3",
  "description": "Accessible reading tools for the web.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Captains",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/features/extract.js",
        "src/features/layout.js",
        "src/features/open-dyslexic.js",
        "src/features/text-to-speech.js",
        "src/content.js"
      ],
      "css": ["src/content-fonts.css", "src/content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}
