{
  "manifest_version": 3,
  "name": "Captains",
  "version": "0.1.0",
  "description": "A cross-browser extension starter for Chrome and Safari.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Captains",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html"
}
